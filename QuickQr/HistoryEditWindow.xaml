<Window x:Class="QuickQr.HistoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit history item" Width="520" Height="400" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="22" Background="{DynamicResource CanvasGradient}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Padding="28" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Edit history item" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Update the content or add a label for easier searching." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,20" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="CONTENT" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="ContentBox" Style="{StaticResource InputBox}" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1200" Margin="0,8,0,16" />
                <TextBlock Text="LABEL" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="TagBox" Style="{StaticResource InputBox}" Height="40" MaxLength="32" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource FlatButton}" Click="Cancel_Click" />
                <Button Content="Save changes" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
