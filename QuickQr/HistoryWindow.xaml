<Window x:Class="QuickQr.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR history" Width="620" Height="560" WindowStartupLocation="CenterOwner"
                Background="Transparent" WindowStyle="None" AllowsTransparency="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border CornerRadius="22" Background="{DynamicResource CanvasGradient}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Padding="2" Effect="{StaticResource SoftShadow}">
            <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="QR history" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Your latest generated codes are shown here." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,6" />
            <TextBlock x:Name="HistorySummaryText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,18" />
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Height="40" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center" Text="" Foreground="{DynamicResource InkBrush}" Background="Transparent" BorderThickness="0" Padding="0" />
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search history..." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,0" IsHitTestVisible="False" Visibility="Visible" />
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" Click="ClearSearch_Click" ToolTip="Clear search" Style="{StaticResource FlatButton}" Background="#26FFFFFF" Foreground="{DynamicResource InkBrush}" BorderBrush="Transparent" FontSize="14" FontFamily="Segoe UI Symbol" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="✕" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <ComboBox x:Name="SortCombo" Style="{StaticResource SelectBox}" Width="150" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="Newest first" Tag="Newest" />
                        <ComboBoxItem Content="Oldest first" Tag="Oldest" />
                        <ComboBoxItem Content="Favorites first" Tag="FavoritesFirst" />
                    </ComboBox>
                    <Button x:Name="AllFilterButton" Content="All" Style="{StaticResource FlatButton}" Click="AllFilter_Click" Margin="0,0,8,0" />
                    <Button x:Name="FavoritesFilterButton" Content="Favorites" Style="{StaticResource FlatButton}" Click="FavoritesFilter_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="HistoryList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource TealBrush}"><TextBlock Text="▦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="Favorite_Click" Tag="{Binding}" Margin="0,0,8,0" Padding="10,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="ToolTip" Value="Add to favorites" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
                                                    <Setter Property="Background" Value="#1A39B7A5" />
                                                    <Setter Property="ToolTip" Value="Remove from favorites" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock FontSize="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="☆" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="★" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Click="CopyHistory_Click" Tag="{Binding}" Margin="0" Padding="10,6" Style="{StaticResource FlatButton}" ToolTip="Copy content">
                                    <TextBlock Text="⧉" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="EmptyText" Text="No saved QR codes yet." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Backup" Style="{StaticResource FlatButton}" Click="Backup_Click" />
                <Button Content="Restore" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Restore_Click" />
                <Button Content="Clear history" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Clear_Click" />
                <Button Content="Close" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Close_Click" />
            </StackPanel>
        </Grid>
            </Grid>
        </Border>
</Window>
